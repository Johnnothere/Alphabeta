# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit .env.
#
# Railway needs all of these as *service variables*. The VITE_ ones are read at
# BUILD time (Vite inlines them into the browser bundle), so changing one only
# takes effect on the next build — Railway stages variable edits, so you have
# to deploy for them to apply.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Same values, read by the server at runtime.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server only. Bypasses row-level security — never prefix this with VITE_,
# or it lands in the browser bundle and anyone can read your whole database.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Canonical public origin, used for canonical/og: tags.
VITE_SITE_URL=https://alphabeta.example

# Shown in the hero and footer. On Railway set this to
# ${{RAILWAY_GIT_COMMIT_SHA}} so the build id is the real commit.
VITE_BUILD_SHA=dev
VITE_APP_VERSION=0.2.0

# How many reverse proxies sit in front of this process, for client-IP
# resolution in rate limiting. Railway's edge is 1; add 1 if you put a CDN in
# front. See src/lib/client-ip.ts and the README note on verifying this.
TRUSTED_PROXY_HOPS=1

# Bind all interfaces. Node does this by default when HOST is unset, but
# Railway requires it, so it is set explicitly rather than relied upon.
HOST=0.0.0.0

# Stops Railpack from detecting a Vite project and serving it as a static SPA,
# which would publish the client bundle and never start the SSR server.
RAILPACK_NO_SPA=1

# Only needed by scripts/new-access-code.mjs (Project Settings → Database).
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
